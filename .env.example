# Copy to .env.local and fill in a strong secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

COMPANION_PORT=7788
COMPANION_URL=http://127.0.0.1:7788
COMPANION_SECRET=replace-with-a-long-random-hex-string

# Default AI provider: "claude" or "codex"
AI_PROVIDER=claude
# Optional model override passed to the provider (blank = provider default)
AI_MODEL=
